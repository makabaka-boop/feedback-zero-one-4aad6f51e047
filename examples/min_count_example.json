{
  "schema": {
    "A": {"arity": 1, "ranks": [0], "key": [0]},
    "R": {"arity": 2, "ranks": [0, 1], "key": [0]}
  },
  "facts": [
    {"rel": "A", "args": ["a"]},
    {"rel": "A", "args": ["b"]}
  ],
  "rules": [
    {
      "body": [{"rel": "A", "args": ["x"]}],
      "head": {"rel": "R", "args": ["x", "y"]}
    }
  ],
  "query": {
    "body": [{"rel": "R", "args": ["x", "y"]}],
    "project": ["y"],
    "aggregate": "min_count"
  }
}
